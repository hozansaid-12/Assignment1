@page "/"
@using ApiContracts
@using BlazorApp.Services
@using BlazorApp.Auth
@inject IPostService PostService
@inject NavigationManager NavMgr
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Posts</PageTitle>

<div class="container mt-4">
    <AuthorizeView>
        <Authorized>
            <h3>Hello, @context.User.Identity?.Name</h3>
            <button class="btn btn-danger mb-3" @onclick="LogoutAsync">
                Log out
            </button>
        </Authorized>
        <NotAuthorized>
            <p>You are not logged in.</p>
            <a href="/login" class="btn btn-primary">Go to login</a>
        </NotAuthorized>
    </AuthorizeView>

    <h1>Posts</h1>

    @if (isLoading)
    {
        <p>Loading posts...</p>
    }
    else if (errorMessage != null)
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (posts.Count == 0)
    {
        <p>No posts found.</p>
    }
    else
    {
        @foreach (PostDto post in posts)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>@post.Title</h5>
                    <a href="@($"/posts/{post.Id}")" class="btn btn-primary">
                        View post
                    </a>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<PostDto> posts = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            posts = (await PostService.GetManyPostsAsync()).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LogoutAsync()
    {
        await ((SimpleAuthProvider)AuthProvider).Logout();
        NavMgr.NavigateTo("/login");
    }
}
