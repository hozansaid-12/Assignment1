
@page "/create-post"
@using ApiContracts
@using BlazorApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IPostService PostService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Create Post</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <h1>Create a Post</h1>

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" @bind="title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Body</label>
                <textarea class="form-control" rows="5" @bind="body"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <p class="text-danger">@errorMessage</p>
            }

            <button class="btn btn-primary"
                    @onclick="CreatePostAsync"
                    disabled="@(string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))">
                Create Post
            </button>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="container mt-4">
            <h3>You have to log in to create a post.</h3>
            <button class="btn btn-primary"
                    @onclick="@(() => Navigation.NavigateTo("/login"))">
                Go to login
            </button>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string title = "";
    private string body = "";
    private string? errorMessage;

    private async Task CreatePostAsync()
    {
        try
        {
            var authenticationState =
                await AuthStateProvider.GetAuthenticationStateAsync();

            var user = authenticationState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var userIdClaim = user.FindFirst("Id");

            if (userIdClaim == null ||
                !int.TryParse(userIdClaim.Value, out int userId))
            {
                errorMessage = "Could not identify the logged-in user.";
                return;
            }

            CreatePostDto request = new()
            {
                Title = title,
                Body = body,
                UserId = userId
            };

            PostDto createdPost =
                await PostService.AddPostAsync(request);

            Navigation.NavigateTo($"/posts/{createdPost.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}

